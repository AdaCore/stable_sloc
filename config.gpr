abstract project Config is

   type Any_Build_Mode is ("dev", "prod");
   Build_Mode : Any_Build_Mode := external("STABLE_SLOC_BUILD_MODE", "dev");

   --  Use -gnatX instead of -gnat2022 to be compatible with the fsf gnat
   Ada_Switches := ("-gnatX", "-g", "-gnatwa");

   type Boolean is ("True", "False");
   C_Support : Boolean := external ("C_SUPPORT", "True");

   case Build_Mode is
      when "dev" =>
         Ada_Switches := Ada_Switches & ("-O0", "-gnata", "-gnatwe", "-gnatyg");
      when "prod" =>
         Ada_Switches := Ada_Switches & ("-O2");
   end case;
    package Compiler is
      for Default_Switches ("Ada") use Ada_Switches;
   end Compiler;

   package Binder is
      case Build_Mode is
         when "dev" =>
            for Default_Switches ("Ada") use ("-Es");
         when "prod" => null;
      end case;
   end Binder;

   package Linker is
      for Required_Switches use
        ("-static-libstdc++", "-static-libgcc");
   end Linker;

end Config;
