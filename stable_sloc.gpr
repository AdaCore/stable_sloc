with "gnatcoll_core.gpr";
with "ada_toml.gpr";
with "libadalang.gpr";
with "libclang.gpr";

with "./config.gpr";

library project Stable_Sloc is

   type Any_Lib_Kind is ("static", "static-pic", "relocatable");
   Lib_Kind : Any_Lib_Kind := external ("LIBRARY_TYPE", "static");
   for Library_Name use "stable_sloc";
   for Library_Kind use Lib_Kind;
   for Library_Dir use "lib-" & Lib_Kind;
   for Object_Dir use "obj-" & Lib_Kind;
   for Source_Dirs use ("src");

   package Naming is
      case Config.C_Support is
         when "False" =>
           for Spec ("Stable_Sloc.Matchers.Clang_Ctx") use "stable_sloc-matchers-clang_ctx__stub.ads";
         when "True" => null;
      end case;
   end Naming;

   case Config.C_Support is
      when "False" =>
         for Excluded_Source_Files use ("stable_sloc-matchers-clang_ctx.adb");
      when "True" => null;
   end case;

   package Compiler renames Config.Compiler;

   package Binder renames Config.Binder;

   package Linker renames Config.Linker;

end Stable_Sloc;
