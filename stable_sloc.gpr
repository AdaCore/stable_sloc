with "gnatcoll.gpr";
with "ada_toml.gpr";
with "libadalang.gpr";

with "./config.gpr";

library project Stable_Sloc is

   type Any_Lib_Kind is ("static", "static-pic", "relocatable");
   Lib_Kind : Any_Lib_Kind := external ("STABLE_SLOC_LIBRARY_KIND", "static");
   for Library_Name use "stable_sloc";
   for Library_Kind use Lib_Kind;
   for Library_Dir use "lib";
   for Object_Dir use "obj";
   for Source_Dirs use ("src");
   
   package Compiler renames Config.Compiler;

   package Binder renames Config.Binder;

end Stable_Sloc;
